# ============================================================
# CallZero Environment Variables
# Copy to server/.env and fill in real values.
# NEVER commit real secrets to version control.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas connection string (production).
# If left empty the server boots an in-memory MongoDB for local demo.
MONGODB_URI=

# ---- Auth ----
# Use a long random string in production:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:5173

# ---- WebRTC (STUN/TURN) ----
# Public STUN server for NAT traversal.
STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server for symmetric NAT / restrictive networks.
# Leave blank if you are not provisioning one. For production with a TURN
# provider, provide credentials.
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ---- Rate limiting (optional overrides) ----
# RATE_LIMIT_WINDOW=900000
# RATE_LIMIT_MAX=200
